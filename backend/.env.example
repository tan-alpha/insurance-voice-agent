# Voice + Chat Insurance Agent - Backend Environment Configuration
# Copy this file to .env and customize as needed.

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------

# Base URL for the backend (used for file upload URLs and WebSocket connections)
BASE_URL=http://localhost:8080

# Public URL for the deployed system (used in Docker entrypoint to replace
# the placeholder VITE_SERVER_URL in the starter UI build)
PUBLIC_URL=http://localhost:8080

# Port to listen on
PORT=8080

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------

DB_PATH=./data/sessions.db
UPLOAD_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Voice Provider Configuration
# ---------------------------------------------------------------------------

# Deepgram API key (for STT and TTS)
DEEPGRAM_API_KEY=

# OpenAI-compatible LLM provider (OpenRouter, Groq, etc.)
OPENROUTER_API_KEY=
# GROQ_API_KEY=

# OpenRouter Free Models:
# LLM: cohere/north-mini-code:free (verified fast tool calling & low latency)
# Vision: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (with effort=none + Pillow fallback)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=cohere/north-mini-code:free
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSIONS_PER_HOUR=30
RATE_LIMIT_UPLOADS_PER_HOUR=60
RATE_LIMIT_CALL_MINUTES=10
